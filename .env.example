# Set these in the server process environment for local development.
# Set this to the exact frontend origin for HTTP CORS and WebSocket signaling.
# The backend reads process environment; it does not load this file.
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Live sessions require both keys. Demo sessions require neither key.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
# Fixed service limits in the 0.2.0 contract, listed here for visibility.
# Session idle TTL: 1800 seconds; maximum WebM clip: 2097152 bytes.
# The backend does not read override variables for these limits.
# The frontend uses the Vite /api dev proxy; production uses same-origin /api.
# API_PORT defaults to 8000 in Vite and Playwright. Set it for port conflicts.
